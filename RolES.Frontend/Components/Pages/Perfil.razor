@page "/perfil"
@using System.Net
@using Microsoft.AspNetCore.Mvc
@using RolES.Frontend.Modelos
@inject HttpClient http
@inject NavigationManager Navegador


<h1>Perfil</h1>

@if (_usuarioAtual is not null)
{
<p>Nome: @_usuarioAtual?.Nome </p>
<p>Email: @_usuarioAtual?.Email </p>
}


@code {
    private usuarioDto? _usuarioAtual;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _usuarioAtual = await http.GetFromJsonAsync<usuarioDto>("/eu");
        }
        catch (HttpRequestException e)
        {
            if (e.StatusCode == HttpStatusCode.Unauthorized) Navegador.NavigateTo("/login");
        }
    }

    

}